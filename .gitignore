cat > .gitignore << 'EOF'
# Environnements virtuels
university_assistant_env/
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Secrets
.env
.env.*
!.env.example

# Documents pédagogiques (potentiellement privés)
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep

# Fichiers générés
data/processed/**
!data/processed/**/
!data/processed/**/.gitkeep

# Index FAISS et caches
data/index/*
!data/index/.gitkeep

# Tests et qualité
.pytest_cache/
.ruff_cache/
.mypy_cache/

# IDE
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# Système
.DS_Store
Thumbs.db
EOF